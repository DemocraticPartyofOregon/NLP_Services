<?php /** @noinspection PhpUnused */

use Drupal\Core\Form\FormStateInterface;

const NLP_MODULE = 'nlpservices';
const NLP_ADMIN_ROLE_ID = 'nlp_admin';
const NLP_COORDINATOR_ROLE_ID = 'nlp_coordinator';
const NLP_LEADER_ROLE_ID = 'nlp_leader';
const NLP_ADMIN_ROLE_LABEL = 'NLP Admin';
const NLP_COORDINATOR_ROLE_LABEL = 'NLP Coordinator';
const NLP_LEADER_ROLE_LABEL = 'NLP Leader';

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * Implements hook_mail_alter
 *
 * For NLP messages, add the signature line and set the language.
 * For email to deliver a turf, add the information to notify
 * the sender if the email is non-deliverable.
 *
 * @param $message
 * @noinspection PhpUnused
 */
function nlpservices_mail_alter(&$message): void
{
  // Suppress the user account creation email.
  if ($message['id'] == 'user_status_activated') {
    $message['send'] = FALSE;
    return;
  }
  switch ($message['module']) {
    case NLP_MODULE:
      $message['headers']['List-Unsubscribe'] =
        "<mailto: notifications@nlpservices.org?subject=unsubscribe>";
      break;
    case 'user':
      
      if ($message['key'] == 'status_activated') {
        $userObj = Drupal::getContainer()->get('nlpservices.drupal_user');
        $currentUser = $userObj->getCurrentUser();
        $firstName = $currentUser['firstName'];
        $lastName = $currentUser['lastName'];
        $fullName = $firstName . " " . $lastName;
        $email = $currentUser['email'];
        $messageAddition = "This email was sent to you by: " . $fullName .
          ".  If you do not know your password, contact your county NLP coordinator.  <br>Email:$email";
        
        $message['body'][] = $messageAddition;
        $message['reply-to'] = $email;
      }
      break;
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * Implements hook_mail
 *
 * @param $key
 * @param $message
 * @param $params
 * @noinspection PhpUnused
 */
function nlpservices_mail($key, &$message, $params): void
{
  if($message['module'] != NLP_MODULE) {return;}
  $boundary = uniqid('np');
  switch ($key) {
    case 'deliver_turf':
    case 'account_reminder':
    case 'forward_nl_reply':
    case 'help_request':
    case 'turf_deletion_notification':
      //if($key=='forward_nl_reply') {
      //  nlp_debug_msg('emailForward', $message);
      //}
      $message['headers']['Content-Type'] = 'multipart/alternative; boundary="'. $boundary.'"';
      $message['subject'] = $params['subject'];
      if(empty($params['from'])) {
        $message['from'] = Drupal::config('system.site')->get('mail');
      } else {
        $message['from'] = $params['from'];
      }
      $message['body'] =  [];
      $msgPlain = "--" . $boundary . "\n";
      $msgPlain .= 'Content-Type: text/plain; charset=UTF-8'."\n";
      $msgPlain .= $params['plainText'];
      $msgHtml = "--" . $boundary . "\n";
      $msgHtml .= "Content-Type: text/html; charset=utf-8\n";
      $msgHtml .= $params['message'];
      $message['body'][0] =  $msgPlain.$msgHtml."\n--" . $boundary . "--";
      break;
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * nlpservices_user_login
 * Implements hook_user_login().
 *
 * Gets the user's county and saves it in the temp storage for various forms.
 *
 * @noinspection PhpUnused
 */
function nlpservices_user_login(Drupal\user\Entity\User $account): void
{
  $userObj = $account::load(Drupal::currentUser()->id());
  $countyValue = $userObj->get('field_county')->getValue();
  if(empty($countyValue)) {return;}
  $county = $countyValue[0]['value'];
  if(empty($county)) {return;}
  $factory = Drupal::service('tempstore.private');
  $storeObj = $factory->get('nlpservices.session_data');
  $storeObj->set('County',$county);
 
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * implements nlp_debug_msg
 *
 * @param $msg
 * @param mixed $values
 */
function nlp_debug_msg($msg, mixed $values='EMPTY'): void
{
  $backTrace = debug_backtrace();
  $file = $backTrace[0]['file'];
  $file_path = explode("/", $file);
  $file_name = end($file_path);
  $messenger = Drupal::messenger();
  
  $fnp = str_replace('.php','', $file_name);
  $caller =  str_replace('nlp_','', $fnp);
  $line = $backTrace[0]['line'];
  $location = '@mod @line ';
  
  $location .= $msg.' = ';
  
  if(is_string($values) OR is_scalar($values) OR empty($values)) {
    if(!empty($values)) {
      if(is_bool($values)) {
        $msg = t($location.'@values', ['@values' => 'TRUE','@mod'=>$caller,'@line'=>$line]);
      } else {
        $msg = t($location.'@values', ['@values' => $values,'@mod'=>$caller,'@line'=>$line]);
      }
    } elseif($values === 0) {
      $msg = t($location.'@values', ['@values' => '0','@mod'=>$caller,'@line'=>$line]);
    } elseif($values === FALSE) {
      $msg = t($location.'@values', ['@values' => 'FALSE','@mod'=>$caller,'@line'=>$line]);
    } elseif($values === NULL) {
      $msg = t($location.'@values', ['@values' => 'NULL','@mod'=>$caller,'@line'=>$line]);
    } else {
      $msg = t($location.'@values', ['@values' => 'empty','@mod'=>$caller,'@line'=>$line]);
    }
  } elseif (is_object($values)) {
    $huh = print_r(json_encode($values),TRUE);
    $msg = t($location."<br><pre>$huh</pre>",
      ['@mod'=>$caller,'@line'=>$line]);
  } else {
    $nice = highlight_string("<?php\n\$values =\n" . var_export($values, true) . ";\n?>", TRUE);
    $msg = t($location."<br><pre>$nice</pre>",
      ['@mod'=>$caller,'@line'=>$line]);
  }
  $messenger->addMessage($msg, $messenger::TYPE_STATUS,TRUE);
}

function nlp_debug_msg_safe($msg, mixed $values='EMPTY'): void
{
  $drupalUserObj = Drupal::getContainer()->get('nlpservices.drupal_user');
  $admin = $drupalUserObj->isNlpAdminUser();
  $nlpConfigurationObj = Drupal::getContainer()->get('nlpservices.configuration');
  $debug = $nlpConfigurationObj->getDebug();
  if($admin AND $debug) {
    nlp_debug_msg($msg,  $values);
    
    $backTrace = debug_backtrace();
    $file = $backTrace[1]['file'];
    $line = $backTrace[1]['line'];
    
    nlp_debug_msg('backTrace',$file.' '.$line);
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * nlpservices_form_alter
