      $form['#attached']['library'][] = 'nlpservices/hint-note';
      $form['#attached']['library'][] = 'nlpservices/table-helper';
      $form['#attached']['library'][] = 'nlpservices/nlp-table';
      break;
    
    case 'nlpservices_login_credentials_reminder_form':
