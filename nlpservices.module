<?php /** @noinspection PhpUnused */

use Drupal\Core\Database\DatabaseException;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Utility\Error;
use Psr\Log\LogLevel;

const NLP_MODULE = 'nlpservices';
const NLP_ADMIN_ROLE_ID = 'nlp_admin';
const NLP_COORDINATOR_ROLE_ID = 'nlp_coordinator';
const NLP_LEADER_ROLE_ID = 'nlp_leader';
const NLP_ADMIN_ROLE_LABEL = 'NLP Admin';
const NLP_COORDINATOR_ROLE_LABEL = 'NLP Coordinator';
const NLP_LEADER_ROLE_LABEL = 'NLP Leader';

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * Implements hook_mail_alter
 *
 * For NLP messages, add the signature line and set the language.
 * For email to deliver a turf, add the information to notify
 * the sender if the email is non-deliverable.
 *
 * @param $message
 * @noinspection PhpUnused
 */
function nlpservices_mail_alter(&$message): void
{
  // Suppress the user account creation email.
  if ($message['id'] == 'user_status_activated') {
    $message['send'] = FALSE;
    return;
  }
  switch ($message['module']) {
    case NLP_MODULE:
      $message['headers']['List-Unsubscribe'] =
        "<mailto: notifications@nlpservices.org?subject=unsubscribe>";
      break;
    case 'user':

      if ($message['key'] == 'status_activated') {
        $userObj = Drupal::service('nlpservices.drupal_user');
        $currentUser = $userObj->getCurrentUser();
        $firstName = $currentUser['firstName'];
        $lastName = $currentUser['lastName'];
        $fullName = $firstName . " " . $lastName;
        $email = $currentUser['email'];
        $messageAddition = t("This email was sent to you by: @name.  If you do not know your password, contact your county NLP coordinator.  <br>Email:@email",
          ['@name' => $fullName, '@email' => $email]);

        $message['body'][] = $messageAddition;
        $message['reply-to'] = $email;
      }
      break;
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * Implements hook_mail
 *
 * @param $key
 * @param $message
 * @param $params
 * @noinspection PhpUnused
 */
function nlpservices_mail($key, &$message, $params): void
{
  if($message['module'] != NLP_MODULE) {return;}
  $boundary = uniqid('np');
  switch ($key) {
    case 'deliver_turf':
    case 'account_reminder':
    case 'forward_nl_reply':
    case 'help_request':
    case 'turf_deletion_notification':
    case 'nlp_admin_notice':
      //if($key=='forward_nl_reply') {
      //  nlp_debug_msg('emailForward', $message);
      //}
      $message['headers']['Content-Type'] = 'multipart/alternative; boundary="'. $boundary.'"';
      if(!empty($params['headers'])) {
        $message['headers'] = array_merge($message['headers'], $params['headers']);
      }
      $message['subject'] = $params['subject'];
      if(empty($params['from'])) {
        $message['from'] = Drupal::service('config.factory')->get('system.site')->get('mail');
      } else {
        $message['from'] = $params['from'];
      }
      $message['body'] =  [];
      $msgPlain = "--" . $boundary . "\n";
      $msgPlain .= 'Content-Type: text/plain; charset=UTF-8'."\n";
      $msgPlain .= $params['plainText'];
      $msgHtml = "--" . $boundary . "\n";
      $msgHtml .= "Content-Type: text/html; charset=utf-8\n";
      $msgHtml .= $params['message'];
      $message['body'][0] =  $msgPlain.$msgHtml."\n--" . $boundary . "--";
      break;
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * nlpservices_user_login
 * Implements hook_user_login().
 *
 * Gets the user's county and saves it in the temp storage for various forms.
 *
 * @noinspection PhpUnused
 */
function nlpservices_user_login(Drupal\user\Entity\User $account): void
{
  $countyValue = $account->get('field_county')->getValue();
  if(empty($countyValue)) {return;}
  $county = $countyValue[0]['value'];
  if(empty($county)) {return;}
  $factory = Drupal::service('tempstore.private');
  $storeObj = $factory->get('nlpservices.session_data');
  $storeObj->set('County',$county);

}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * implements nlp_debug_msg
 *
 * An exception passed as $values is also written to the log, with its
 * backtrace, so errors caught in try/catch blocks aren't only shown on screen.
 *
 * @param $msg
 * @param mixed $values
 */
function nlp_debug_msg($msg, mixed $values='EMPTY'): void
{
  $backTrace = debug_backtrace(DEBUG_BACKTRACE_IGNORE_ARGS, 2);
  $frame = $backTrace[0] ?? [];
  $file = $frame['file'] ?? __FILE__;
  $file_name = basename($file);
  $messenger = Drupal::messenger();

  $fnp = str_replace('.php','', $file_name);
  $caller =  str_replace('nlp_','', $fnp);
  $line = (int) ($frame['line'] ?? 0);

  if ($values instanceof Throwable) {
    $level = ($values instanceof DatabaseException)
      ? LogLevel::ERROR : LogLevel::WARNING;
    Error::logException(Drupal::logger('nlpservices'), $values,
      '@caller (@mod @callerLine): %type: @message in %function (line %line of %file).',
      ['@caller' => $msg, '@mod' => $caller, '@callerLine' => $line], $level);
    $values = $values->getMessage();
  }
  $location = '@mod @line ';

  $location .= $msg.' = ';

  if(is_string($values) OR is_scalar($values) OR empty($values)) {
    if(!empty($values)) {
      if(is_bool($values)) {
        $msg = t($location.'@values', ['@values' => 'TRUE','@mod'=>$caller,'@line'=>$line]);
      } else {
        $msg = t($location.'@values', ['@values' => $values,'@mod'=>$caller,'@line'=>$line]);
      }
    } elseif($values === 0) {
      $msg = t($location.'@values', ['@values' => '0','@mod'=>$caller,'@line'=>$line]);
    } elseif($values === FALSE) {
      $msg = t($location.'@values', ['@values' => 'FALSE','@mod'=>$caller,'@line'=>$line]);
    } elseif($values === NULL) {
      $msg = t($location.'@values', ['@values' => 'NULL','@mod'=>$caller,'@line'=>$line]);
    } else {
      $msg = t($location.'@values', ['@values' => 'empty','@mod'=>$caller,'@line'=>$line]);
    }
  } elseif (is_object($values)) {
    $huh = json_encode($values);
    $msg = t($location."<br><pre>$huh</pre>",
      ['@mod'=>$caller,'@line'=>$line]);
  } else {
    $nice = highlight_string("<?php\n\$values =\n" . var_export($values, true) . ";\n?>", TRUE);
    $msg = t($location."<br><pre>$nice</pre>",
      ['@mod'=>$caller,'@line'=>$line]);
  }
  $messenger->addMessage($msg, $messenger::TYPE_STATUS,TRUE);
}

function nlp_debug_msg_safe($msg, mixed $values='EMPTY'): void
{
  $drupalUserObj = Drupal::service('nlpservices.drupal_user');
  $admin = $drupalUserObj->isNlpAdminUser();
  $nlpConfigurationObj = Drupal::service('nlpservices.configuration');
  $debug = $nlpConfigurationObj->getDebug();
  if($admin AND $debug) {
    nlp_debug_msg($msg,  $values);

    $backTrace = debug_backtrace(DEBUG_BACKTRACE_IGNORE_ARGS, 4);
    if(empty($backTrace)) {return;}
    $messenger = Drupal::messenger();
    $file = $backTrace[1]['function'] ?? 'unknown';
    $line = $backTrace[1]['line'] ?? 'unknown';
    $messenger->addMessage('backtrace: '.$file.' '.$line);
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * nlpservices_form_alter
 * Implements hook_form_alter().
 *
 * Used to provide CSS for various forms used in NLP Services.
 *
 * @noinspection PhpUnused
 * @noinspection PhpUnusedParameterInspection
 */
function nlpservices_form_alter(&$form, FormStateInterface $form_state, $form_id): void
{
  //nlp_debug_msg('$form_id',$form_id);
  switch ($form_id) {
    case 'user_form':
      $form['actions']['submit']['#submit'][] = 'nlpservices_user_submit';
      break;

    case 'user_login_form':
      $form['actions']['submit']['#value'] = t('Login to Account');
      $form['#validate'][] = 'nlpservices_login_validate';
      break;
  }
}


/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * nlpservices_login_validate
 *
 * Report login failures to the log file.   We're looking for attempts to guess passwords and to help
 * NLs who are having trouble with login.
 *
 * @param $form
 * @param FormStateInterface $form_state
 * @return void
 * @noinspection PhpUnused
 * @noinspection PhpUnusedParameterInspection
 */
function nlpservices_login_validate(&$form, FormStateInterface $form_state): void
{
  $values = $form_state->getValues();
  $pass = $values['pass'];
  $userName = $values['name'];
  //nlp_debug_msg('user',$userName.' '.$pass);

  $userObj = Drupal::service('nlpservices.drupal_user');
  $user = $userObj->getUserByName($userName);
  //nlp_debug_msg('$user',$user);
  if(empty($user)) {
    Drupal::logger('nlpservices')->notice('Unknown user login attempt: '.$userName.' '.$pass);
    ///nlp_debug_msg('$values',$values);
    if(filter_var($userName, FILTER_VALIDATE_EMAIL)) {
      $messenger = Drupal::messenger();
      $messenger->addWarning(t('An email address is not a valid Username.'));
    }
    return;
  }
  $mcid = $user['mcid'];
  if(empty($mcid)) { return; }  // No need to record the PW mistake for non-NLP users.
  $magicWordObj = Drupal::service('nlpservices.magic_word');
  $magicWord = $magicWordObj->getMagicWord($mcid);
  $admin = (in_array('administrator',$user['roles']) OR in_array('nlp_admin',$user['roles']));
  if($pass !== $magicWord && !$admin) {
    Drupal::logger('nlpservices')->notice('Login attempt: '.$userName.' miss matched pass: '
      .$pass.' ['.$magicWord.']');
  }
  //nlp_debug_msg('$mcid',$mcid);
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * nlpservices_user_submit
 *
 * Saves a password change by an NLP Services user.
 *
 * @param $form
 * @param FormStateInterface $form_state
 * @return void
 * @noinspection PhpUnused
 * @noinspection PhpUnusedParameterInspection
 */
function nlpservices_user_submit(&$form, FormStateInterface $form_state): void
{
  //nlp_debug_msg('values',$form_state->getValues());
  $mcidValue = $form_state->getValue('field_mcid');
  if(!empty($mcidValue[0]['value'])) {
    $mcid = $mcidValue[0]['value'];
    $pass = $form_state->getValue('pass');
    if(!empty($pass)) {
      $magicWordObj = Drupal::service('nlpservices.magic_word');
      $magicWord = $magicWordObj->getMagicWord($mcid);
      if($magicWord !== $pass) {
        $magicWordObj->setMagicWord($mcid,$pass);
      }
    }
  }


}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * nlpservices_cron
 *
 * If enabled, this cron function will check for emails with MiniVAN reports.  These
 * reports are recovered from VoteBuilder by a script run by the DPO. The attachment will
 * have many duplicates of past reports. We include prior reports to catch ballots
 * because NLs can delay syncing a canvas.
 *
 * If enabled, this function will check for emails with an attachment with
 * matchback reports.  These reports are the date the county elections departments
 * scanned a ballot and are reporting it was received. The attachment will have many
 * duplicates of past reports.  We include prior reports to catch ballots that may have
 * been delayed in the scan or reporting process.
 *
 * If enabled, this function will check for emails sent to notifications that should have
 * been sent to the coordinator.   When the coordinator can be determined, the emails are
 * automatically forwarded.   Most of these should be from automated processes like bounce
 * or out-of-office replies.  Occasionally, a volunteer may reply to a notification.
 *
 * If enabled, this function will check if any turfs are suspected to be out of sync with
 * VoteBuilder.   If so, the turfs are resynced.  This is done at night so that the
 * resyncing process does not interfere with the normal operation of the system.
 *
 * @return void
 */
function nlpservices_cron (): void
{
  $nlpConfigurationObj = Drupal::service('nlpservices.configuration');

  $nlpConfigObj = Drupal::service('config.factory')->get('nlpservices.configuration');
  $cronConfiguration = $nlpConfigObj->get('nlpservices-cron-configuration');

  // Check for emails with MiniVAN reports.
  $enableMinivan = !empty($cronConfiguration['enableMinivan']);
  if($enableMinivan) {
    $minivanObj = Drupal::service('nlpservices.minivan');
    $startTime = time();
    try {
      $counts = $minivanObj->processMinivanEmails();
      if ($counts['recordCount'] > 0) {
        $elapsed = time() - $startTime;
        $h = floor($elapsed / 3600);
        $m = floor(($elapsed % 3600) / 60);
        $s = $elapsed % 60;
        $msg = "MiniVAN import elapsed: $h:$m:$s" .
          ' Records=' . $counts['recordCount'] .
          ' New=' . $counts['newRecordCount'] .
          ' Skipped=' . $counts['skippedRecordCount'] .
          ' Rejected=' . $counts['rejectedRecordCount'] .
          ' Not NLP=' . $counts['notNlpCount'];
        Drupal::logger('nlpservices')->notice($msg);
      }
    } catch (Exception $e) {
      Drupal::logger('nlpservices')->error('Minivan cron error: @msg', ['@msg' => $e->getMessage()]);
    }
  }

  // Check for emails with matchback reports.
  $enableMatchback = !empty($cronConfiguration['enableMatchback']);
  if($enableMatchback) {
    $queue = Drupal::queue('nlpservices_matchback_queue');
    $matchbackObj = Drupal::service('nlpservices.matchbacks');
    while (TRUE) {
      $filePath = $matchbackObj->matchbackEmailFetch();
      if (empty($filePath)) { break; }
      $config = Drupal::service('config.factory')->getEditable('nlpservices.configuration');
      $config->set('nlpservices-last-matchback-time', time());
      $config->save();
      $queue->createItem(['filePath' => $filePath]);
    }
  }

  // Check for emails sent to notifications that should have been sent to the coordinator.
  $enableEmailRedirect = !empty($cronConfiguration['enableEmailRedirect']);
  if($enableEmailRedirect) {
    //nlp_debug_msg('email redirect check');
    $notificationRepliesObj = Drupal::service('nlpservices.email_replies');
    $notificationRepliesObj->emailForward();
  }

  // Check if turf resync is enabled but run the check only at night, assumes standard 3-hour cron frequency.
  $enableTurfResync = !empty($cronConfiguration['enableTurfResync']);
  $hour = (int) date('G');
  $resyncCheckTime = ($hour >= 0 && $hour < 3) || $nlpConfigurationObj->getDebug();
  if($enableTurfResync && $resyncCheckTime) {
    $resyncTurfObj = Drupal::service('nlpservices.resync_turf');
    $turfsObj = Drupal::service('nlpservices.turfs');
    $countiesWithTurfs = $turfsObj->getCountyNames();
    $queue = Drupal::queue('nlpservices_resync_turfs_queue');

    $startTime = time();
    $queueStart = TRUE;
    foreach ($countiesWithTurfs as $county) {
      $queueItems = $resyncTurfObj->turfsToResyncCheck($county);
      if(empty($queueItems)) { continue; }
      // We have a county with at least one turf to check.
      $turfCount = 0;
      if($queueStart) {
        // Mark the first turf to start the timing the resyncing process.
        $queueItems[0]['queueStart'] = 'start';
        $queueStart = FALSE;
      }

      foreach ($queueItems as $queueItem) {
        $queue->createItem($queueItem);
        $turfCount = $turfCount + count($queueItem['turfIndexes']);
      }
      Drupal::logger('nlpservices')->notice("Resync turf check for county: $county turf count: $turfCount");
    }

    // If there was at least one turf to check, add a final item to mark the end of the queue.
    if(!$queueStart) {
      $queueItem = [
        'county' => 'lastCounty',
        'queueStart' => 'end',
        'turfIndexes' => []
      ];
      $queue->createItem($queueItem);
    }

    $queueTime = time() - $startTime;
    $hours = floor($queueTime / 3600);
    $minutes = floor(($queueTime % 3600) / 60);
    $secs = $queueTime % 60;
    $displayTime = "$hours:$minutes:$secs";
    nlp_debug_msg('Turf resync check time: ', $displayTime);
    Drupal::logger('nlpservices')->notice('Turf resync check time: ' . $displayTime);
  }

  // Check for missing NLP Voter activist codes, run only at night between midnight and 3am.
  $enableVoterAcCheck = !empty($cronConfiguration['enableVoterAcCheck']);
  $hour = (int) date('G');
  $acCheckTime = ($hour >= 0 && $hour < 3) || $nlpConfigurationObj->getDebug();
  if ( $enableVoterAcCheck && $acCheckTime ) {
    $turfsObj = Drupal::service('nlpservices.turfs');

    try {
      $syncedCounties = $turfsObj->getSyncedCountyNames();

      $queue = Drupal::queue('nlpservices_voter_ac_queue');
      $queue->deleteQueue();
      $queue->createQueue();
      $turfCount = 0;
      foreach ($syncedCounties as $county) {
        $turfIndexes = $turfsObj->getTurfIndexes($county);
        foreach ($turfIndexes as $turfIndex) {
          $queue->createItem(['turfIndex' => $turfIndex]);
          $turfCount++;
        }
      }
      Drupal::logger('nlpservices')->notice("Voter AC check queued $turfCount turfs.");
    } catch (Exception $e) {
      Drupal::logger('nlpservices')->error('Voter AC check cron error: @msg', ['@msg' => $e->getMessage()]);
    }
  }

  // Queue expired turf status records for activist code verification.
  $enableTurfAcCheck = !empty($cronConfiguration['enableTurfAcCheck']);
  if ($enableTurfAcCheck) {
    $turfStatusObj = Drupal::service('nlpservices.turf_status');
    try {
      $expiredRecords = $turfStatusObj->getExpiredPendingTurfStatuses();
    } catch (Exception $e) {
      Drupal::logger('nlpservices')->error('enableTurfAcCheck cron error: @msg', ['@msg' => $e->getMessage()]);
    }
    if (!empty($expiredRecords)) {
      $queue = Drupal::queue('nlpservices_turf_ac_check_queue');
      foreach ($expiredRecords as $record) {
        $queue->createItem($record);
      }
      Drupal::logger('nlpservices')->notice(
        'Queued @count expired turf status record(s) for activist code verification.',
        ['@count' => count($expiredRecords)]
      );
    }
  }

}

/** @noinspection PhpUnusedParameterInspection */
/**
 * @param $form
 * @param FormStateInterface $form_state
 * @param $form_id
 * @return void
 */
function nlpservices_form_user_form_alter(&$form, FormStateInterface $form_state, $form_id): void
{
  $form['#validate'][] = 'nlpservices_custom_validation';
}

/** @noinspection PhpUnusedParameterInspection */
/**
 * @param $form
 * @param FormStateInterface $form_state
 * @return void
 */
function nlpservices_custom_validation($form, FormStateInterface $form_state): void
{
  $countyValue = $form_state->getValue('field_county');
  $county = $countyValue[0]['value'] ?? '';
  $counties = Drupal::service('nlpservices.configuration')->getCountyNames();
  if(empty($county)) {return;}
  if($county == 'State' || !in_array($county, $counties)) {
    $form_state->setErrorByName('field_county', t('Invalid county name.'));
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * Implements hook_node_view().
 *
 * Prevents the Welcome page node from being cached so that election
 * date changes propagate immediately to all visitors.
 *
 * @noinspection PhpUnused
 * @noinspection PhpUnusedParameterInspection
 */
function nlpservices_node_view(array &$build, Drupal\node\NodeInterface $node, Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, string $view_mode): void
{
  if ($node->bundle() === 'page' && $node->label() === 'Welcome') {
    $build['#cache']['max-age'] = 0;
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
 * This converts a string to hex for debugging
 *
 * @param $string
 * @return string
 * @noinspection PhpUnused
 */
function strToHex($string): string
{
  $hex = '';
  $len = strlen($string);
  for ($i = 0; $i < $len; $i++) {
    $so = ord($string[$i]);
    $sh = dechex($so);
    $shp = str_pad($sh, 2, '0',STR_PAD_LEFT);
    if(($so < 128) AND ($so > 31)) {
      $hex .= ' '.$string[$i].' '.$shp;
    } else {
      $hex .= ' .. '.$shp;
    }
    if($i>255) {break;}
  }
  return $hex;
}

