<?php

use Drupal\Core\Entity\EntityStorageException;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_uninstall().
 * @noinspection PhpUnused
 * @noinspection PhpUnusedParameterInspection
 */
function nlpservices_uninstall($is_syncing): void
{
  $fields = [
    'county',
    'first_name',
    'last_name',
    'mcid',
    'hd',
    'phone',
    //'shared_email',
    //'turf_access',
  ];

  foreach ($fields as $field) {
    $fieldName = 'field_'.$field;
    $fieldStorage = FieldStorageConfig::loadByName('user', $fieldName);
    if (!empty($fieldStorage)) {
      try {
        $fieldStorage->delete();
      }
      catch (EntityStorageException $e) {
        nlp_debug_msg('nlpservices_uninstall',$e->getMessage());
      }
    }
  }
}

/** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
