{
    "name": "drupal/nlpservices",
    "description": "Neighborhood Leader organizing module for Drupal 10",
    "type": "drupal-custom-module",
    "license": "GPL-2.0-or-later",
    "require": {
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/dependency-injection": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\nlpservices\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\nlpservices\\": "tests/src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
