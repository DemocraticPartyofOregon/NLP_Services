{
    "name": "drupal/nlpservices",
    "description": "Neighborhood Leader organizing module for Drupal 10",
    "type": "drupal-custom-module",
    "license": "GPL-2.0-or-later",
    "require": {},
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\nlpservices\\": "src/"
        }
    },
    "autoload-dev": {
